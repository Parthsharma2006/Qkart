<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF6EC">

    <!-- TOP ORANGE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FF9800">

        <!-- TITLE ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:text="QKart"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- CART ICON -->
                <ImageView
                    android:id="@+id/ivCart"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_cart"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />

                <!-- CART BADGE -->
                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_cart_badge"
                    android:text="1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>


        </LinearLayout>

        <!-- SEARCH BAR -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search"
            android:hint="Find your favorite food..."
            android:padding="12dp"
            android:inputType="text"/>
    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HERO IMAGE -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/qkart_logo"/>

        <!-- TITLE -->
        <TextView
            android:text="Available Canteens"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- 🔥 CANTEEN LIST (SCROLLS PROPERLY NOW) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCanteens"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"/>
    </LinearLayout>

</LinearLayout>
